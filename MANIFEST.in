graft skills
graft optional-skills
# crm/ is the Next.js + TypeScript real-estate CRM app (with its own
# Python sub-agent under crm/agent/). It is NOT part of the Python sdist
# for chippi-agent — it ships and deploys independently (Node build,
# Modal deploy for the sub-agent). Excluding it keeps the wheel/sdist
# from ballooning with node_modules, build artifacts, and TS sources.
prune crm
global-exclude __pycache__
global-exclude *.py[cod]
